#typed String, Int32, UUID, Int64, size_t, byte, URL
#dstrcts List

struct RoomListing {
    UUID roomUUID;
    String motd;
    Int32 members;
};

struct ChatMessage {
    UUID chatMessageUUID;
    String sender;
    String content;
    List<URL> attachments;
    Int64 unixTimestamp;
};

struct AttachmentAsset {
    byte attachment[];
    size_t size;
}

POST /api/auth/login <-> void
GET /api/auth/me <-> void
POST /api/auth/logout <-> void

GET /api/chatrooms/listing?limit={LIMIT}
<- body: {
    List<struct RoomListing>: public_rooms
}

POST /api/chatrooms/{chat room UUID}/join
-> body: { 
    Optional<String>: room_invite_code
}
<- body: {
    Optional<String>: error_message
}

POST /api/chatrooms/{chat room UUID}/leave
-> body: { 
    bool: silent_leave,
    Optional<String>: reason 
}
<- body: {
    Optional<String>: error_message
}

GET /api/chatrooms/{chat room UUID}/overview
<- body: {
    String: motd,
    String: owner,
    List<String>: member_names
}

// usage after pagniation:
// use POST /api/chatrooms/{chat room UUID}/messages, and then use messages[0].uuid
GET /api/chatrooms/{chat room UUID}/history?limit={LIMIT}&before_message={message_uuid} 
<- body: {
    List<struct ChatMessage>: messages // from old->new
}

POST /api/chatrooms/{chat room UUID}/messages
-> post body: { 
    String: message_content, 
    Optional<List<struct AttachmentAsset>>: uploaded_files 
}
<- body: {
    Optional<String>: error_message
}

DELETE /api/chatrooms/{chat room UUID}/messages/{message UUID}
<- body: {
    Optional<String>: error_message
}

PATCH /api/chatrooms/{chat room UUID}/messages/{message UUID}
-> body: {
    String: new_content, 
    bool: keep_attachments
}
<- body: {
    Optional<String>: error_message
}